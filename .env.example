# Copy to .env and adjust. Never commit the real .env.

# --- Application ---
PROJECT_NAME=AITraderPro
ENVIRONMENT=local
DEBUG=true
BACKEND_PORT=8000

# --- Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-me-with-openssl-rand-hex-32-output-not-this-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# --- Postgres ---
POSTGRES_USER=aitrader
POSTGRES_PASSWORD=aitrader
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aitraderpro
DB_ECHO=false

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Bootstrap superuser ---
FIRST_SUPERUSER_EMAIL=admin@aitraderpro.local
FIRST_SUPERUSER_PASSWORD=ChangeMe123!

# --- Dashboard ---
API_BASE_URL=http://backend:8000/api/v1

# --- Phase 2 placeholders (Zerodha Kite) ---
KITE_API_KEY=
KITE_API_SECRET=

# --- Broker: Zerodha Kite (Phase 2) ---
KITE_API_KEY=
KITE_API_SECRET=

# Vault key for broker tokens. MUST differ from SECRET_KEY.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Trading safety. Both default to the safe setting. ---
LIVE_TRADING_ENABLED=false
TRADING_HALTED=false
PAPER_STARTING_CASH=1000000
